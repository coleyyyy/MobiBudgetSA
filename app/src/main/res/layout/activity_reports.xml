<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reports"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/totalIncomeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Income: R 0.00"
        android:textSize="20sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/totalExpensesTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Expenses: R 0.00"
        android:textSize="20sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/balanceReportTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Balance: R 0.00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/reportSummaryTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Spending Summary"
        android:textSize="18sp" />

</LinearLayout>